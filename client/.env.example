# Plantilla de variables de entorno del frontend (Expo).
# Copia este archivo a .env.local y rellena los valores.
# Las variables con prefijo EXPO_PUBLIC_ se incluyen en la app, así que solo
# pueden ser claves públicas (publishable). Nunca pongas aquí la secret key.

# Project URL de Supabase: Project Settings → API.
EXPO_PUBLIC_SUPABASE_URL=

# Publishable key de Supabase: Project Settings → API Keys.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
